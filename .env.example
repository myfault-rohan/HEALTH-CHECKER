# ─── Health Checker Pro — Environment Variables ───
# Copy this file to .env and fill in real values before running.
#   cp .env.example .env

# ─── Required ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
FLASK_SECRET_KEY=change-me-to-a-random-secret

# ─── Database (Docker Compose / Production) ────────
POSTGRES_USER=health_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=health_db
DATABASE_URL=postgresql://health_user:change-me-to-a-strong-password@db:5432/health_db

# ─── Flask ─────────────────────────────────────────
FLASK_ENV=production

# ─── ML Microservice ──────────────────────────────
ML_SERVICE_URL=http://ml:8000
